{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh",
						"timeout": 30,
						"statusMessage": "Formatting and linting"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check.sh",
						"timeout": 120,
						"statusMessage": "Checking format, lint, dead code and changelog"
					}
				]
			}
		]
	}
}
