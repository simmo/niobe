{
	"name": "niobe",
	"version": "2.0.1-beta.2",
	"description": "Tooling for creating durations",
	"keywords": [
		"date",
		"date-time",
		"datetime",
		"duration",
		"helpers",
		"time",
		"tools",
		"utilities"
	],
	"homepage": "https://niobe.js.org/",
	"bugs": "https://github.com/simmo/niobe/issues",
	"license": "MIT",
	"author": "Mike Simmonds (https://mike.id)",
	"repository": "github:simmo/niobe",
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsdown",
		"dead-code": "fallow dead-code",
		"docs:build": "vitepress build docs",
		"docs:build:all": "node scripts/build-docs.ts",
		"docs:dev": "vitepress dev docs",
		"docs:preview": "vitepress preview docs",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"release": "release-it",
		"test": "vitest --project unit",
		"test:coverage": "vitest run --coverage --project unit",
		"test:package": "vitest run --project package",
		"typecheck": "tsc --noEmit --extendedDiagnostics && tsc --noEmit -p src && tsc --noEmit -p docs/.vitepress/theme"
	},
	"devDependencies": {
		"@release-it/keep-a-changelog": "^8.0.1",
		"@shikijs/vitepress-twoslash": "^4.6.0",
		"@tsconfig/node26": "^26.0.1",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"fallow": "^3.39.0",
		"oxfmt": "^0.76.0",
		"oxlint": "^1.91.0",
		"release-it": "^21.1.2",
		"tsdown": "^0.23.5",
		"tsx": "^4.23.15",
		"twoslash": "^0.3.9",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitepress": "2.0.0-alpha.21",
		"vitepress-plugin-llms": "^1.14.0",
		"vitest": "^5.1.0",
		"vue": "^3.5.44"
	},
	"lint-staged": {
		"*": "npm run format -- --no-error-on-unmatched-pattern",
		"*.{js,jsx,ts,tsx,mjs,cjs}": "npm run lint"
	},
	"engines": {
		"node": ">=22.12"
	},
	"release-it": {
		"hooks": {
			"before:git:release": "npx oxfmt CHANGELOG.md && git add CHANGELOG.md"
		},
		"github": {
			"release": true
		},
		"npm": {
			"skipChecks": true,
			"stage": true
		},
		"plugins": {
			"@release-it/keep-a-changelog": {
				"addUnreleased": true,
				"addVersionUrl": true,
				"filename": "CHANGELOG.md"
			}
		}
	}
}
