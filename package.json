{
	"name": "niobe",
	"version": "2.0.0",
	"description": "Tooling for creating durations",
	"keywords": [
		"date",
		"date-time",
		"datetime",
		"duration",
		"helpers",
		"time",
		"tools",
		"utilities"
	],
	"homepage": "https://github.com/simmo/niobe#readme",
	"bugs": "https://github.com/simmo/niobe/issues",
	"license": "MIT",
	"author": "Mike Simmonds (https://mike.id)",
	"repository": "github:simmo/niobe",
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.jcs",
	"module": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "rollup -c rollup.config.ts --configPlugin typescript",
		"coverage": "vitest run --coverage",
		"dead-code": "fallow dead-code",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"postbuild": "rm -rf ./dist/.types",
		"prebuild": "rm -rf ./dist",
		"release": "release-it",
		"test": "vitest",
		"typecheck": "tsc --noEmit --extendedDiagnostics"
	},
	"devDependencies": {
		"@release-it/keep-a-changelog": "^7.0.0",
		"@rollup/plugin-commonjs": "^28.0.3",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.1",
		"@rollup/plugin-terser": "^0.4.4",
		"@rollup/plugin-typescript": "^12.1.2",
		"@tsconfig/node-lts": "^22.0.1",
		"@types/node": "^22.15.3",
		"@vitest/coverage-v8": "^3.1.3",
		"fallow": "^3.36.0",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"release-it": "^19.0.2",
		"rollup": "^4.40.1",
		"rollup-plugin-dts": "^6.2.1",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3",
		"vitest": "^3.1.3"
	},
	"lint-staged": {
		"*": "npm run format -- --no-error-on-unmatched-pattern",
		"*.{js,jsx,ts,tsx,mjs,cjs}": "npm run lint"
	},
	"release-it": {
		"hooks": {
			"before:git:release": "npx oxfmt CHANGELOG.md && git add CHANGELOG.md"
		},
		"github": {
			"release": true
		},
		"plugins": {
			"@release-it/keep-a-changelog": {
				"addUnreleased": true,
				"addVersionUrl": true,
				"filename": "CHANGELOG.md"
			}
		}
	}
}
